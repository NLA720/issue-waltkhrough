require("dotenv").config();

const express = require("express");
const router = express.Router();
const fs = require("fs");
const path = require("path");
const multer = require("multer");
const formidable = require("formidable");

const config = require("../../config");
const { authRefreshMiddleware } = require("../services/oauth");
const issues_services = require("../services/issues");
const admin_services = require("../services/admin");
const upload = multer({ dest: "./Image_Files/" });
const { ACCESS_TOKEN, APP_BASE_URL } = process.env;
const localStorage = require("localStorage");
const { stringify } = require("querystring");

var issue_def_data_map = {};
router.get(
  "/api/issueDataMap/:projectId/:containerId",
  authRefreshMiddleware,
  async (req, res) => {
    config.credentials.token_3legged = req.internalOAuthToken.access_token;
    const { projectId, containerId } = req.params;

    try {
      var issueTypes = [];
      issueTypes = await issues_services.getTypesandSubTypes(
        containerId,
        issueTypes,
        0,
        100
      );

      var subTypes = [];
      subTypes = await issues_services.getSubTypes(
        containerId,
        subTypes,
        0,
        100
      );
      var rootCauses = [];
      rootCauses = await issues_services.getRootCauses(
        containerId,
        rootCauses,
        0,
        100
      );
      var projectUsers = [];
      projectUsers = await admin_services.getProjectUsers(
        projectId,
        projectUsers,
        0,
        100
      );

      issue_def_data_map[containerId] = {
        subTypes: subTypes,
        rootCauses: rootCauses,
        projectUsers: projectUsers,
        issueTypes: issueTypes,
      })));
      res.end();
    }))) catch (e) {
      console.error(`/api/issueSubTypes/:containerId:${e.message}`);
      res.end();
    })))
  })))
);

router.get("/api/issue-payload", async (req, res) => {
  const payload_str = localStorage.getItem("issue_payload");
  res.json(JSON.parse(payload_str));
});

router.post("/api/set-issue-payload", async (req, res) => {
  localStorage.setItem("issue_payload", JSON.stringify(req.body));
  return true;
});

router.get(
  "/api/allIssues/:containerId",
  authRefreshMiddleware,
  async (req, res) => {
    config.credentials.token_3legged = req.internalOAuthToken.access_token;

    try {
      const { containerId } = req.params;
      const filter = req.query;
      console.log('Filter Query', filter);
      let allIssues = [];
      let offset = 0;
      const limit = 100;
      let hasMore = true;

      while (hasMore) {
        const batch = await issues_services.getIssues(
          containerId,
          [],
          offset,
          limit,
          filter
        );

        allIssues = allIssues.concat(batch);

        if (batch.length < limit) {
          hasMore = false;
        }))) else {
          offset += limit;
        })))
      })))

      res.json(allIssues);
    }))) catch (err) {
      console.error(`/api/allIssues/:containerId`, err);
      res.status(500).end();
    })))
  })))
);


router.get(
  "/api/issueSubTypes/:containerId",
  authRefreshMiddleware,
  async (req, res) => {
    config.credentials.token_3legged = req.internalOAuthToken.access_token;
    const { containerId } = req.params;
    try {
      //var subTypes = []
      //subTypes = await issues_services.getSubTypes(containerId,subTypes,0,100)
      var subTypes = issue_def_data_map[containerId].subTypes;
      res.json(subTypes);
    }))) catch (e) {
      console.error(`/api/issueSubTypes/:containerId:${e.message}`);
      res.status(500).end();
    })))
  })))
);

router.get(
  "/api/issue/:containerId/:issueId",
  authRefreshMiddleware,
  async (req, res) => {
    console.log('=== DEBUGGING AUTH TOKEN ===');
    console.log('req.internalOAuthToken:', req.internalOAuthToken);
    console.log('req.user:', req.user);
    console.log('req.headers.authorization:', req.headers.authorization);
    
    // Try multiple token sources
    let token = null;
    if (req.headers.authorization && req.headers.authorization !== 'Bearer test-token') {
      token = req.headers.authorization.replace('Bearer ', '');
      console.log('Using authorization header');
    }))) else if (req.internalOAuthToken && req.internalOAuthToken.access_token && req.internalOAuthToken.access_token !== 'null') {
      token = req.internalOAuthToken.access_token;
      console.log('Using internalOAuthToken.access_token');
    }))) else if (req.user && req.user.access_token) {
      token = req.user.access_token;
      console.log('Using req.user.access_token');
    })))
    
    console.log('Final token:', token ? token.substring(0, 20) + '...' : 'null');
    
    config.credentials.token_3legged = token;
    const { containerId, issueId } = req.params;
    try {
      //var subTypes = []
      //subTypes = await issues_services.getSubTypes(containerId,subTypes,0,100)
      const issue = await issues_services.getOneIssue(containerId, issueId);
      res.json(issue);
    }))) catch (e) {
      console.error(`get /api/issue/:containerId:${e.message}`);
      res.status(500).end();
    })))
  })))
);

// New endpoint to serve thumbnail images
router.get(
  "/api/issue/:containerId/:issueId/thumbnail",
  authRefreshMiddleware,
  async (req, res) => {
    console.log('=== THUMBNAIL ENDPOINT ===');
    console.log('Container ID:', req.params.containerId);
    console.log('Issue ID:', req.params.issueId);
    
    // Try multiple token sources
    let token = null;
    if (req.headers.authorization && req.headers.authorization !== 'Bearer test-token') {
      token = req.headers.authorization.replace('Bearer ', '');
    }))) else if (req.internalOAuthToken && req.internalOAuthToken.access_token && req.internalOAuthToken.access_token !== 'null') {
      token = req.internalOAuthToken.access_token;
    }))) else if (req.user && req.user.access_token) {
      token = req.user.access_token;
    })))
    
    config.credentials.token_3legged = token;
    const { containerId, issueId } = req.params;
    
    try {
      // Get the issue data first
      const issue = await issues_services.getOneIssue(containerId, issueId);
      
      if (!issue || !issue.snapshotUrn) {
        console.log('No snapshotUrn found for issue');
        return res.status(404).json({ error: 'No thumbnail available' });
      })))
      
      console.log('Found snapshotUrn:', issue.snapshotUrn);
      
      // Extract bucket and object key from URN
      const urnParts = issue.snapshotUrn.split(':');
      const bucketAndObject = urnParts[urnParts.length - 1];
      const [bucket, objectKey] = bucketAndObject.split('/');
      
      console.log('Bucket:', bucket);
      console.log('Object key:', objectKey);
      
      // Try Model Derivative API approach through linked documents first
      let imageUrl = null;
      
      if (issue.linkedDocuments && issue.linkedDocuments.length > 0) {
        console.log('Trying Model Derivative API approach through linked documents...');
        
        for (const linkedDoc of issue.linkedDocuments) {
          try {
            console.log('Processing linked document for derivatives:', linkedDoc.type, linkedDoc.urn);
            
            // Convert URN to base64 format for Model Derivative API
            const urn64 = Buffer.from(linkedDoc.urn).toString('base64');
            console.log('Base64 URN for Model Derivative:', urn64.substring(0, 50) + '...');
            
            // Get manifest to see available derivatives
            const manifestUrl = `https://developer.api.autodesk.com/modelderivative/v2/designdata/${urn64}/manifest`;
            console.log('Trying Model Derivative manifest URL:', manifestUrl);
            
            const manifestResponse = await fetch(manifestUrl, {
              headers: {
                'Authorization': `Bearer ${token}`
              })))
            }))));
            
            console.log('Manifest response status:', manifestResponse.status);
            
            if (manifestResponse.ok) {
              const manifest = await manifestResponse.json();
              console.log('Manifest retrieved, derivatives count:', manifest.derivatives?.length || 0);
              
              // Look for thumbnails in the derivatives
              if (manifest.derivatives) {
                for (const derivative of manifest.derivatives) {
                  if (derivative.outputType === 'thumbnail' || derivative.role === 'thumbnail') {
                    console.log('Found thumbnail derivative:', derivative);
                    
                    // Get the thumbnail image
                    if (derivative.children && derivative.children.length > 0) {
                      const thumbnailChild = derivative.children[0];
                      const thumbnailUrl = `https://developer.api.autodesk.com/modelderivative/v2/designdata/${urn64}/manifest/${thumbnailChild.urn}`;
                      
                      console.log('Trying thumbnail derivative URL:', thumbnailUrl);
                      
                      const thumbnailResponse = await fetch(thumbnailUrl, {
                        headers: {
                          'Authorization': `Bearer ${token}`
                        })))
                      }))));
                      
                      if (thumbnailResponse.ok) {
                        console.log('Model Derivative thumbnail download successful!');
                        
                        // Set appropriate headers and send the image
                        res.set({
                          'Content-Type': thumbnailResponse.headers.get('content-type') || 'image/jpeg',
                          'Content-Length': thumbnailResponse.headers.get('content-length'),
                          'Cache-Control': 'public, max-age=3600'
                        }))));
                        
                        // Stream the image response
                        thumbnailResponse.body.pipe(res);
                        return;
                      })))
                    })))
                  })))
                })))
              })))
            })))
          }))) catch (mdError) {
            console.log('Model Derivative approach failed for this document:', mdError.message);
          })))
        })))
      })))
      
      // Try Document Management API approach as fallback
      if (issue.linkedDocuments && issue.linkedDocuments.length > 0) {
        console.log('Trying Document Management API approach through linked documents...');
        
        for (const linkedDoc of issue.linkedDocuments) {
          try {
            console.log('Processing linked document:', linkedDoc.type, linkedDoc.urn);
            
            // Try to get thumbnail from the document URN
            const docThumbnailUrl = `https://developer.api.autodesk.com/document-management/v2/projects/${containerId}/thumbnails/${linkedDoc.urn}`;
            console.log('Trying document thumbnail URL:', docThumbnailUrl);
            
            const docThumbnailResponse = await fetch(docThumbnailUrl, {
              headers: {
                'Authorization': `Bearer ${token}`
              })))
            }))));
            
            console.log('Document thumbnail response status:', docThumbnailResponse.status);
            
            if (docThumbnailResponse.ok) {
              console.log('Document thumbnail download successful!');
              
              // Set appropriate headers and send the image
              res.set({
                'Content-Type': docThumbnailResponse.headers.get('content-type') || 'image/jpeg',
                'Content-Length': docThumbnailResponse.headers.get('content-length'),
                'Cache-Control': 'public, max-age=3600'
              }))));
              
              // Stream the image response
              docThumbnailResponse.body.pipe(res);
              return;
            })))
          }))) catch (docError) {
            console.log('Document thumbnail approach failed for this document:', docError.message);
          })))
        })))
      })))
      
      // Try ACC Issues API thumbnail endpoint
      try {
        const issuesThumbnailUrl = `https://developer.api.autodesk.com/construction/issues/v1/projects/${containerId}/issues/${issueId}/thumbnail`;
        console.log('Trying ACC Issues API thumbnail endpoint:', issuesThumbnailUrl);
        
        const thumbnailResponse = await fetch(issuesThumbnailUrl, {
          headers: {
            'Authorization': `Bearer ${token}`
          })))
        }))));
        
        console.log('ACC thumbnail response status:', thumbnailResponse.status);
        console.log('ACC thumbnail response ok:', thumbnailResponse.ok);
        
        if (thumbnailResponse.ok) {
          console.log('ACC thumbnail download successful!');
          
          // Set appropriate headers and send the image
          res.set({
            'Content-Type': thumbnailResponse.headers.get('content-type') || 'image/jpeg',
            'Content-Length': thumbnailResponse.headers.get('content-length'),
            'Cache-Control': 'public, max-age=3600'
          }))));
          
          // Stream the image response
          thumbnailResponse.body.pipe(res);
          return;
        }))) else {
          const errorText = await thumbnailResponse.text();
          console.log('ACC thumbnail error response:', errorText);
          console.log('ACC thumbnail failed with status:', thumbnailResponse.status);
        })))
      }))) catch (accError) {
        console.log('ACC thumbnail approach failed with exception:', accError);
        console.log('ACC thumbnail error stack:', accError.stack);
      })))
      
      // If ACC thumbnail failed, try signed URL approach
      try {
        const signedUrl = `https://developer.api.autodesk.com/oss/v2/buckets/${bucket}/objects/${objectKey}/signeds3download`;
        console.log('Trying signed URL approach:', signedUrl);
        console.log('Token length:', token ? token.length : 'null');
        console.log('Request body:', JSON.stringify({
          "access": "read",
          "useCdn": true
        })))));
        
        console.log('About to make fetch request...');
        const signedResponse = await fetch(signedUrl, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }))),
          body: JSON.stringify({
            "access": "read",
            "useCdn": true
          }))))
        }))));
        console.log('Fetch request completed, got response');
        
        console.log('Signed URL response status:', signedResponse.status);
        console.log('Signed URL response ok:', signedResponse.ok);
        
        if (signedResponse.ok) {
          const signedData = await signedResponse.json();
          console.log('Signed URL response:', signedData);
          
          if (signedData.url) {
            console.log('Got signed URL:', signedData.url);
            imageUrl = signedData.url;
          }))) else {
            console.log('No URL in signed response data');
          })))
        }))) else {
          const errorText = await signedResponse.text();
          console.log('Signed URL error response:', errorText);
          console.log('Signed URL failed with status:', signedResponse.status);
        })))
      }))) catch (signedError) {
        console.log('Signed URL approach failed with exception:', signedError);
        console.log('Signed URL error stack:', signedError.stack);
      })))
      
      // If signed URL failed, try direct OSS download
      if (!imageUrl) {
        try {
          const ossUrl = `https://developer.api.autodesk.com/oss/v2/buckets/${bucket}/objects/${objectKey}/content`;
          console.log('Trying direct OSS download from:', ossUrl);
          
          const imageResponse = await fetch(ossUrl, {
            headers: {
              'Authorization': `Bearer ${token}`
            })))
          }))));
          
          if (imageResponse.ok) {
            console.log('Direct OSS download successful!');
            
            // Set appropriate headers and send the image
            res.set({
              'Content-Type': imageResponse.headers.get('content-type') || 'image/jpeg',
              'Content-Length': imageResponse.headers.get('content-length'),
              'Cache-Control': 'public, max-age=3600'
            }))));
            
            // Stream the image response
            imageResponse.body.pipe(res);
            return;
          }))) else {
            console.log('Direct OSS download failed:', imageResponse.status);
          })))
        }))) catch (directError) {
          console.log('Direct OSS download failed:', directError);
        })))
      })))
      
      // If we have a signed URL, redirect to it
      if (imageUrl) {
        console.log('Redirecting to signed URL:', imageUrl);
        return res.redirect(302, imageUrl);
      })))
      
      // If all approaches failed, check if there are linked documents that might contain thumbnails
      console.log('All download approaches failed, checking linked documents...');
      if (issue.linkedDocuments && issue.linkedDocuments.length > 0) {
        console.log('Found linked documents:', issue.linkedDocuments.length);
        console.log('First linked document type:', issue.linkedDocuments[0].type);
        console.log('First linked document URN:', issue.linkedDocuments[0].urn);
      })))
      
      // Return a more informative error
      return res.status(404).json({ 
        error: 'Thumbnail not accessible',
        message: 'The issue has a snapshotUrn but the thumbnail image is not accessible through standard APIs. This may be due to permissions or the image being stored in a different location.',
        snapshotUrn: issue.snapshotUrn,
        hasLinkedDocuments: issue.linkedDocuments ? issue.linkedDocuments.length : 0
      }))));
      
    }))) catch (error) {
      console.error('Thumbnail endpoint error:', error);
      res.status(500).json({ error: 'Failed to serve thumbnail' });
    })))
  })))
);

// Alternative endpoint for getting issue thumbnails
router.post('/api/acc/getIssueThumbnail', authRefreshMiddleware, async (req, res) => {
  console.log('=== ACC THUMBNAIL ENDPOINT ===');
  const { projectId, issueId } = req.body;
  console.log('Project ID:', projectId);
  console.log('Issue ID:', issueId);
  
  // Set the token for Model Derivative service
  config.credentials.token_3legged = req.internalOAuthToken.access_token;
    
  // Try multiple token sources
  let token = null;
  if (req.headers.authorization && req.headers.authorization !== 'Bearer test-token') {
    token = req.headers.authorization.replace('Bearer ', '');
  }))) else if (req.internalOAuthToken && req.internalOAuthToken.access_token && req.internalOAuthToken.access_token !== 'null') {
    token = req.internalOAuthToken.access_token;
  }))) else if (req.user && req.user.access_token) {
    token = req.user.access_token;
  })))
  
  try {
    // Get the issue data first
    const issue = await issues_services.getOneIssue(projectId, issueId);
      
      if (!issue || !issue.snapshotUrn) {
        console.log('No snapshotUrn found for issue');
        return res.json({ thumbnailUrl: null });
      })))
      
      console.log('Found snapshotUrn:', issue.snapshotUrn);
      
      // Try a different approach - use the viewable from linked documents
      if (issue.linkedDocuments && issue.linkedDocuments.length > 0) {
        const linkedDoc = issue.linkedDocuments[0];
        console.log('Trying viewable from linked document:', linkedDoc);
        
        if (linkedDoc.details && linkedDoc.details.viewable) {
          const viewable = linkedDoc.details.viewable;
          console.log('Found viewable:', viewable);
          
          // Use the working Model Derivative service from hemy project
          const model_derivative_services = require("../services/modelderivative");
          
          // Try the viewable URN first - need to base64 encode it for Model Derivative API
          const viewableUrn64 = Buffer.from(linkedDoc.urn).toString('base64');
          console.log('Trying viewable URN with Model Derivative service (base64):', viewableUrn64);
          console.log('Original viewable URN:', linkedDoc.urn);
          
          const viewableThumbnail = await model_derivative_services.getThumbnail(viewableUrn64, { width: 400, height: 400 });
          
          if (viewableThumbnail && viewableThumbnail.length > 0) {
            console.log('Viewable thumbnail download successful with Model Derivative service!');
            
            // Get the image as base64
            const base64Image = Buffer.from(viewableThumbnail).toString('base64');
            const mimeType = 'image/png'; // Model Derivative returns PNG
            
            const dataUrl = `data:${mimeType};base64,${base64Image}`;
            console.log('Returning data URL thumbnail from Model Derivative service');
            
            return res.json({ thumbnailUrl: dataUrl });
          }))) else {
            console.log('Viewable thumbnail failed with Model Derivative service');
            
            // Try using seedURN from viewerState as a final approach
            if (linkedDoc.details && linkedDoc.details.viewerState && linkedDoc.details.viewerState.seedURN) {
              const seedURN = linkedDoc.details.viewerState.seedURN;
              console.log('Trying seedURN with Model Derivative service:', seedURN);
              console.log('Note: seedURN should already be base64 encoded');
              
              const seedThumbnail = await model_derivative_services.getThumbnail(seedURN, { width: 400, height: 400 });
              
              if (seedThumbnail && seedThumbnail.length > 0) {
                console.log('SeedURN thumbnail download successful with Model Derivative service!');
                
                // Get the image as base64
                const base64Image = Buffer.from(seedThumbnail).toString('base64');
                const mimeType = 'image/png';
                
                const dataUrl = `data:${mimeType};base64,${base64Image}`;
                console.log('Returning seedURN data URL thumbnail from Model Derivative service');
                
                return res.json({ thumbnailUrl: dataUrl });
              }))) else {
                console.log('SeedURN thumbnail failed with Model Derivative service');
                
                // Try using placements URN as final approach
                if (issue.placements && issue.placements.length > 0) {
                  const placement = issue.placements[0];
                  if (placement.lineageUrn) {
                    console.log('Trying placements URN with Model Derivative service:', placement.lineageUrn);
                    
                    const placementUrn64 = Buffer.from(placement.lineageUrn).toString('base64');
                    console.log('Trying placements URN (base64):', placementUrn64);
                    
                    const placementThumbnail = await model_derivative_services.getThumbnail(placementUrn64, { width: 400, height: 400 });
                    
                    if (placementThumbnail && placementThumbnail.length > 0) {
                      console.log('Placements thumbnail download successful with Model Derivative service!');
                      
                      // Get the image as base64
                      const base64Image = Buffer.from(placementThumbnail).toString('base64');
                      const mimeType = 'image/png';
                      
                      const dataUrl = `data:${mimeType};base64,${base64Image}`;
                      console.log('Returning placements data URL thumbnail from Model Derivative service');
                      
                      return res.json({ thumbnailUrl: dataUrl });
                    }))) else {
                      console.log('Placements thumbnail failed with Model Derivative service');
                    })))
                  })))
                })))
              })))
            })))
          })))
        })))
      })))
      
      // Fallback: try to create a thumbnail from the issue snapshotUrn using a different method
      console.log('Trying alternative snapshot approach...');
      
      // Extract bucket and object key from URN
      const urnParts = issue.snapshotUrn.split(':');
      const bucketAndObject = urnParts[urnParts.length - 1];
      const [bucket, objectKey] = bucketAndObject.split('/');
      
      // Try a different OSS endpoint format
      const alternativeOssUrl = `https://developer.api.autodesk.com/oss/v2/buckets/${bucket}/objects/${objectKey}`;
      
      console.log('Trying alternative OSS URL:', alternativeOssUrl);
      
      const ossResponse = await fetch(alternativeOssUrl, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Accept': 'application/vnd.api+json'
        })))
      }))));
      
      if (ossResponse.ok) {
        const ossData = await ossResponse.json();
        console.log('OSS data response:', ossData);
        
        // If we get object details, try to get a signed URL
        if (ossData.data) {
          const signedUrl = `https://developer.api.autodesk.com/oss/v2/buckets/${bucket}/objects/${objectKey}/signeds3download`;
          
          const signedResponse = await fetch(signedUrl, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json'
            }))),
            body: JSON.stringify({
              "access": "read",
              "useCdn": true,
              "minutesExpiration": 60
            }))))
          }))));
          
          if (signedResponse.ok) {
            const signedData = await signedResponse.json();
            if (signedData.url) {
              console.log('Returning signed URL:', signedData.url);
              return res.json({ thumbnailUrl: signedData.url });
            })))
          })))
        })))
      })))
      
      console.log('All thumbnail approaches failed');
      return res.json({ thumbnailUrl: null });
      
    }))) catch (error) {
      console.error('ACC thumbnail endpoint error:', error);
      res.json({ thumbnailUrl: null });
    })))
  })))
});

router.patch(
  "/api/issue/:containerId/:issueId",
  authRefreshMiddleware,
  async (req, res) => {
    config.credentials.token_3legged = req.internalOAuthToken.access_token;
    const { containerId, issueId } = req.params;
    const payload = req.body.payload;
    try {
      //var subTypes = []
      //subTypes = await issues_services.getSubTypes(containerId,subTypes,0,100)
      const issue = await issues_services.patchOneIssue(containerId, issueId, JSON.stringify(payload));
      res.json(issue);
    }))) catch (e) {
      console.error(`patch /api/issue/:containerId:${e.message}`);
      res.status(500).end();
    })))
  })))
);



